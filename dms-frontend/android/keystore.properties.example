# Release signing config for the DrawVault Android app.
#
# 1. Generate an upload keystore (choose your own strong passwords):
#      keytool -genkey -v -keystore drawvault-upload.keystore \
#        -alias drawvault -keyalg RSA -keysize 2048 -validity 10000
#    Keep the keystore + passwords safe and backed up — losing them means you
#    can't ship updates under the same app.
#
# 2. Copy this file to `keystore.properties` (gitignored) in the same dir and
#    fill in the real values below. `storeFile` is resolved relative to the
#    android/ directory (rootProject), so an absolute path is safest.
#
# 3. Build: `npm run android:sync && cd android && ./gradlew bundleRelease`

storeFile=drawvault-upload.keystore
storePassword=CHANGE_ME
keyAlias=drawvault
keyPassword=CHANGE_ME
